# ==============================================================================
# MEDIGUARD AI - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế của bạn trước khi chạy.
# ==============================================================================

# 1. BẢO MẬT & XÁC THỰC
# Khóa bí mật dùng để mã hóa JWT Token đăng nhập của Người chăm sóc (tạo chuỗi ngẫu nhiên dài >= 32 ký tự)
SECRET_KEY=mediguard-ai-super-secret-key-change-me-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mã PIN 4 số nhanh để chuyển từ màn hình Kiosk Người già sang chế độ Cài đặt Người chăm sóc
CAREGIVER_PIN=1234


# 2. CƠ SỞ DỮ LIỆU
# Mặc định dùng SQLite cho giai đoạn thử nghiệm MVP 1 (chạy ngay không cần cài đặt)
DATABASE_URL=sqlite:///./mediguard.db
# Khi triển khai thực tế trên máy chủ có thể chuyển sang PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/mediguard_db


# 3. QUẢN LÝ LỊCH & CẢNH BÁO AN TOÀN
# Thời gian chờ phản hồi (phút): Nếu sau số phút này kể từ khi phát lời nhắc mà bác chưa bấm phản hồi
# hệ thống sẽ tự động kích hoạt Notifier gửi cảnh báo khẩn cấp đến điện thoại con cái/người thân.
NO_RESPONSE_MINUTES=15


# 4. KÊNH THÔNG BÁO KHẨN CẤP GIA ĐÌNH (TELEGRAM BOT)
# Token của Bot Telegram (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_ExampleToken

# Chat ID của người chăm sóc hoặc nhóm chat gia đình (Lấy qua bot @userinfobot hoặc @RawDataBot)
TELEGRAM_CHAT_ID=-1001234567890


# 5. CẤU HÌNH VOICE AI & TRỢ LÝ TIẾNG VIỆT
# Giọng đọc Edge-TTS tiếng Việt mặc định:
# - vi-VN-HoaiMyNeural: Giọng nữ miền Nam/Bắc ấm áp, truyền cảm, dễ nghe (Khuyên dùng cho người già)
# - vi-VN-NamMinhNeural: Giọng nam trầm, rõ ràng
MEDIGUARD_VOICE=vi-VN-HoaiMyNeural


# 6. CẤU HÌNH MẠNG & HỆ THỐNG
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000